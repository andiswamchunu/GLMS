@model IReadOnlyList<ServiceRequest>
@{
    ViewData["Title"] = "Service requests";
}
<div class="page-head">
    <div><h1>Service requests</h1><p class="lead-muted">Costs are reported in ZAR.</p></div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New service request</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state"><i class="bi bi-inboxes"></i><p>No service requests yet.</p></div>
}
else
{
    <div class="panel p-0">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>#</th><th>Description</th><th>Contract</th><th class="text-end">Original</th><th class="text-end">Cost (ZAR)</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@r.Id" class="fw-semibold">#@r.Id</a></td>
                    <td>@r.Description</td>
                    <td><a asp-controller="Contracts" asp-action="Details" asp-route-id="@r.ContractId">#@r.ContractId · @r.Contract?.Client?.Name</a></td>
                    <td class="text-end">@r.OriginalAmount.ToString("N2") @r.CurrencyCode</td>
                    <td class="text-end fw-semibold">R @r.CostZar.ToString("N2")</td>
                    <td><span class="badge status-@r.Status.ToString().ToLowerInvariant()">@r.Status</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
