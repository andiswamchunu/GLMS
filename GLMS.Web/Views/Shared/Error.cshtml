@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="empty-state">
    <i class="bi bi-bug"></i>
    <h1 class="h4">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the dashboard</a>
</div>
