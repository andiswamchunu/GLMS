@model Contract
@{
    ViewData["Title"] = "Edit contract";
}
<div class="page-head"><div><h1>Edit contract #@Model.Id</h1><p class="lead-muted">Status: <span class="badge status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span> (change it from the contract page)</p></div></div>
<div class="panel form-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" view-data="ViewData" />
        <button class="btn btn-primary" type="submit">Save changes</button>
        <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
