@model Client
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ContactDetails" class="form-label"></label>
    <input asp-for="ContactDetails" class="form-control" placeholder="Email | phone" />
    <span asp-validation-for="ContactDetails" class="text-danger"></span>
</div>
<div class="mb-4">
    <label asp-for="Region" class="form-label"></label>
    <input asp-for="Region" class="form-control" />
    <span asp-validation-for="Region" class="text-danger"></span>
</div>
