@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5" style="max-width: 440px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="mb-3">GLMS Login</h2>
            <p class="text-muted">
                Sign in to access the Global Logistics
                Management System.
            </p>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label for="username"
                           class="form-label">Username</label>
                    <input type="text"
                           id="username"
                           name="username"
                           class="form-control"
                           autocomplete="username"
                           required />
                </div>

                <div class="mb-3">
                    <label for="password"
                           class="form-label">Password</label>
                    <input type="password"
                           id="password"
                           name="password"
                           class="form-control"
                           autocomplete="current-password"
                           required />
                </div>

                <button type="submit"
                        class="btn btn-primary w-100">
                    Sign In
                </button>
            </form>
        </div>
    </div>
</div>
